{
	"name": "mediasoup-sample-2024-h3-solidjs",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "DEV_ENV=jb varlock run -- docker compose up -d --remove-orphans --build",
		"stop": "DEV_ENV=jb varlock run -- docker compose down",
		"restart": "bun stop && bun start",
		"logs": "DEV_ENV=jb varlock run -- docker compose logs -f",
		"start-logs": "bun start && bun logs",
		"restart-logs": "bun restart && bun logs",
		"flush-cache": "sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.7.3",
		"varlock": "^1.9.0"
	},
	"peerDependencies": {
		"typescript": "^5.7.3"
	},
	"workspaces": [
		"packages/*"
	],
	"dependencies": {},
	"trustedDependencies": [
		"esbuild",
		"nx"
	]
}
