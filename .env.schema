# Shared Docker and Traefik configuration for local infrastructure.

# @currentEnv=$DEV_ENV
# @defaultRequired=true @defaultSensitive=false
# ---

# Local profile selector. Root package scripts set DEV_ENV=jb inline for
# Docker/Traefik commands.
# @type=enum(development, jb, test, production)
DEV_ENV=development

# Public domain used by Traefik router labels.
# @type=string
SERVICE_DOMAIN=

# Existing external Docker network used by docker compose.
# @type=string
TRAEFIK_NETWORK=

# Domain Offensive DNS API token consumed by Traefik/lego. Local profiles
# should provide resolver refs in .env.<profile>; prod/CI should provide
# TRAEFIK_DODE_TOKEN from platform secrets.
# @sensitive
TRAEFIK_DODE_TOKEN=
