# Server runtime configuration.

# @defaultRequired=true @defaultSensitive=false
# ---

# Local networking mode used to derive the announced mediasoup IP.
# @type=enum(localhost, localhost.debug, lan)
MODE=

# Enables Deno OpenTelemetry export for local metrics.
# @type=boolean
OTEL_DENO=

# Optional debug namespace filter used by dependencies that honor DEBUG.
# @required=false @type=string
DEBUG=
