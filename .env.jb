# JB local dev profile for:
# /Users/bjesuiter/Develop/bjesuiter/mediasoup-sample-2024-h3-solidjs
#
# Root package scripts select this profile with DEV_ENV=jb inline.
#
SERVICE_DOMAIN=tagungsapps.de
TRAEFIK_NETWORK=traefik_ingress

# Varlock-native keychain() ref created by varlock keychain import.
#
# Local macOS Keychain item:
# - service: varlock
# - account: mediasoup-sample-2024-h3-solidjs:jb:TRAEFIK_DODE_TOKEN
# - provenance label/comment when creating the item: local dev secret for
#   TRAEFIK_DODE_TOKEN in project mediasoup-sample-2024-h3-solidjs profile jb at
#   /Users/bjesuiter/Develop/bjesuiter/mediasoup-sample-2024-h3-solidjs
#
# Re-import from the ignored plaintext .env without printing values:
# varlock keychain import .env --project mediasoup-sample-2024-h3-solidjs --profile jb --write-to .env.jb --force
#
# Prod/CI should provide TRAEFIK_DODE_TOKEN from platform secrets instead of
# macOS Keychain.
TRAEFIK_DODE_TOKEN=keychain(service="varlock", account="mediasoup-sample-2024-h3-solidjs:jb:TRAEFIK_DODE_TOKEN")
